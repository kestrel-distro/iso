#!/bin/bash

# The ISO configurator: collects the answers the installer needs and writes them
# as an answers set (archinstall-shaped JSON, read as plain data). Sources the
# payload's shared setup form so install and first-boot provisioning can never
# offer different prompts.
#
# Side channels:
#   end of input (1) -> unwind to the start of the form
#   Ctrl+C       (130) -> first screen: prepare for another owner (deferred);
#                         disk confirmation: toggle disk encryption

export KESTREL_PATH="${KESTREL_PATH:-/usr/share/kestrel}"
export KESTREL_INSTALL="${KESTREL_INSTALL:-$KESTREL_PATH/install}"

# Rely on the live-ISO installer helpers for styling and error handling.
source /root/helpers/all.sh
source "$KESTREL_INSTALL/provisioning/setup-form.sh"

# tzupdate guesses the timezone for the user.
command -v tzupdate >/dev/null || sudo pacman -Sy --noconfirm tzupdate

notice() {
  clear_logo
  echo
  printf '%s\n' "$1"
  sleep "${2:-1}"
  echo
}

step() {
  clear_logo
  echo
  printf '%s%s\n\n' "$PADDING_LEFT_SPACES" "$1"
}

deferred=0
encrypt=1
disk_mode=full

# ── Keyboard (Ctrl+C -> deferred) ────────────────────────────────────────────

keyboard_form() {
  step "Let's setup your machine..."
  local status
  kestrel_prompt_keyboard && status=0 || status=$?
  case $status in
    0) ;;
    130)
      deferred=1
      keyboard="es"
      keyboard_label="Spanish"
      notice "Preparing this machine for another owner, keyboard and account setup will run on first boot" 3
      ;;
    *) abort "Aborted installation" ;;
  esac
}

# ── Account ──────────────────────────────────────────────────────────────────

user_form() {
  if ((deferred)); then
    return 0
  fi
  step "Let's setup your user account..."

  local status
  kestrel_prompt_username || status=$?
  if [[ ${status:-0} == 130 ]]; then
    deferred=1
    notice "Preparing this machine for another owner" 3
    return 0
  elif [[ ${status:-0} != 0 ]]; then
    abort "Aborted installation"
  fi

  kestrel_prompt_password || status=$?
  [[ ${status:-0} == 0 ]] || abort "Aborted installation"

  kestrel_prompt_identity || status=$?
  [[ ${status:-0} == 0 ]] || abort "Aborted installation"

  password_hash=$(printf '%s' "$password" | openssl passwd -6 -stdin)
}

# ── Hostname + timezone ──────────────────────────────────────────────────────

system_form() {
  step "Name this machine..."
  local status
  kestrel_prompt_hostname || status=$?
  [[ ${status:-0} == 0 ]] || abort "Aborted installation"
  kestrel_prompt_timezone || status=$?
  [[ ${status:-0} == 0 ]] || abort "Aborted installation"
}

# ── Disk ─────────────────────────────────────────────────────────────────────

get_disk_info() {
  local device="$1" size model
  size=$(lsblk -dno SIZE "$device" 2>/dev/null)
  model=$(lsblk -dno MODEL "$device" 2>/dev/null | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
  local display="$device"
  [[ -n $size ]] && display="$display ($size)"
  [[ -n $model ]] && display="$display - $model"
  echo "$display"
}

disk_form() {
  step "Let's select where to install Kestrel..."

  local exclude_disk
  exclude_disk=$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null || true)

  local available_disks disk_options="" disk_info selected_display
  available_disks=$(
    lsblk -dpno NAME,TYPE |
      awk '$2=="disk"{print $1}' |
      grep -E '/dev/(sd|hd|vd|nvme|mmcblk|xv)' |
      { if [[ -n "$exclude_disk" ]]; then grep -Fvx "$exclude_disk"; else cat; fi; }
  )

  while IFS= read -r device; do
    [[ -n $device ]] || continue
    disk_info=$(get_disk_info "$device")
    disk_options+="$disk_info"$'\n'
  done <<<"$available_disks"

  local -a disks=()
  mapfile -t disks < <(printf '%s' "$disk_options" | sed '/^$/d')
  selected_display=$(kestrel_choose "Select install disk:" "${disks[@]}") || abort "Aborted installation"
  disk=$(echo "$selected_display" | awk '{print $1}')

  # Full-disk wipes it; free-space installs into unallocated space alongside
  # other operating systems.
  disk_mode=$(kestrel_choose "How should Kestrel use ${disk}?" "full" "free-space") || abort "Aborted installation"
}

disk_confirm() {
  while true; do
    printf '%sEverything on %s will be overwritten. There is no recovery possible.\n\n' \
      "$PADDING_LEFT_SPACES" "$disk"
    local status
    kestrel_confirm "Confirm installing to ${disk}" && status=0 || status=$?
    case $status in
      0) break ;;
      130) # Ctrl+C toggles disk encryption
        if ((encrypt)); then
          encrypt=0
          notice "Encryption off, the disk will be installed unencrypted" 2
        else
          encrypt=1
          notice "Encryption on" 1
        fi
        ;;
      *) disk_form ;;
    esac
  done
}

# ── Run ──────────────────────────────────────────────────────────────────────

while true; do
  keyboard_form
  user_form
  system_form
  disk_form

  printf '%s%-12s %s\n' "$PADDING_LEFT_SPACES" "Username" "${username:-[deferred]}" \
    "$PADDING_LEFT_SPACES" "Password" "$([[ -n ${password:-} ]] && printf '%*s' "${#password}" | tr ' ' '*' || echo [deferred])" \
    "$PADDING_LEFT_SPACES" "Hostname" "${hostname}" \
    "$PADDING_LEFT_SPACES" "Timezone" "${timezone}" \
    "$PADDING_LEFT_SPACES" "Keyboard" "${keyboard_label}" \
    "$PADDING_LEFT_SPACES" "Disk" "${disk}" \
    "$PADDING_LEFT_SPACES" "Layout" "$disk_mode" \
    "$PADDING_LEFT_SPACES" "Encryption" "$([[ $encrypt == 1 ]] && echo yes || echo no)"

  echo
  if kestrel_confirm "Does this look right?"; then
    break
  fi
done

disk_confirm

clear

# ── Write answers ────────────────────────────────────────────────────────────

echo "${full_name:-}" >user_full_name.txt
echo "${email_address:-}" >user_email_address.txt

username_escaped=$(printf '%s' "${username:-}" | jq -Rsa)
password_escaped=$(printf '%s' "${password:-}" | jq -Rsa)
password_hash_escaped=$(printf '%s' "${password_hash:-}" | jq -Rsa)

if ((deferred)); then
  touch defer-provisioning
  rm -f user_credentials.json
else
  rm -f defer-provisioning
  cat <<-_EOF_ >user_credentials.json
{
    "encryption_password": $password_escaped,
    "root_enc_password": $password_hash_escaped,
    "users": [
        {
            "enc_password": $password_hash_escaped,
            "groups": [],
            "sudo": true,
            "username": $username_escaped
        }
    ]
}
_EOF_
fi

# Partition plan in the same shape the configurator always wrote, so external
# tooling that reads it keeps working.
disk_size=$(lsblk -bdno SIZE "$disk")
mib=$((1024 * 1024))
gib=$((mib * 1024))
disk_size_in_mib=$((disk_size / mib * mib))

gpt_backup_reserve=$((mib))
boot_partition_start=$((mib))
boot_partition_size=$((2 * gib))

main_partition_start=$((boot_partition_size + boot_partition_start))
main_partition_size=$((disk_size_in_mib - main_partition_start - gpt_backup_reserve))

encryption_block=""
if ((encrypt)); then
  encryption_block=",
        \"disk_encryption\": {
            \"encryption_type\": \"luks\",
            \"lvm_volumes\": [],
            \"iter_time\": 2000,
            \"partitions\": [ \"8c2c2b92-1070-455d-b76a-56263bab24aa\" ],
            \"encryption_password\": $password_escaped
        }"
fi

cat <<-_EOF_ >user_configuration.json
{
    "kestrel_disk_mode": "$disk_mode",
    "hostname": "$hostname",
    "timezone": "$timezone",
    "bootloader": "Limine",
    "kernels": [ "linux" ],
    "disk_config": {
        "btrfs_options": { "snapshot_config": { "type": "Snapper" } },
        "config_type": "default_layout",
        "device_modifications": [
            {
                "device": "$disk",
                "wipe": $([[ $disk_mode == "full" ]] && echo true || echo false),
                "partitions": [
                    {
                        "flags": [ "boot", "esp" ],
                        "fs_type": "fat32",
                        "mountpoint": "/boot",
                        "obj_id": "ea21d3f2-82bb-49cc-ab5d-6f81ae94e18d",
                        "size": { "unit": "B", "value": $boot_partition_size },
                        "start": { "unit": "B", "value": $boot_partition_start },
                        "type": "primary"
                    },
                    {
                        "btrfs": [
                            { "mountpoint": "/", "name": "@" },
                            { "mountpoint": "/home", "name": "@home" },
                            { "mountpoint": "/var/log", "name": "@log" },
                            { "mountpoint": "/var/cache/pacman/pkg", "name": "@pkg" }
                        ],
                        "fs_type": "btrfs",
                        "mount_options": [ "compress=zstd" ],
                        "obj_id": "8c2c2b92-1070-455d-b76a-56263bab24aa",
                        "size": { "unit": "B", "value": $main_partition_size },
                        "start": { "unit": "B", "value": $main_partition_start },
                        "type": "primary"
                    }
                ]
            }
        ]$encryption_block
    },
    "locale_config": {
        "kb_layout": "$keyboard",
        "sys_enc": "UTF-8",
        "sys_lang": "en_US.UTF-8"
    }
}
_EOF_

if [[ ${1:-} == "dry" ]]; then
  echo -e "User Configuration:"
  cat user_configuration.json
  [[ -f user_credentials.json ]] && { echo -e "\n\nUser Credentials:"; cat user_credentials.json; }
  echo -e "\n\nFull name: ${full_name:-}"
  echo "Email address: ${email_address:-}"
  [[ -f defer-provisioning ]] && echo "Deferred provisioning: yes"
  rm -f user_configuration.json user_credentials.json user_full_name.txt user_email_address.txt defer-provisioning
fi
