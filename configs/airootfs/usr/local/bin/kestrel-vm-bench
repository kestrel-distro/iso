#!/bin/bash

# Dev-only: run the full benchmark matrix on a live VM when the host share
# contains a `run-bench` marker. The live session autostarts this; normal boots
# do nothing because the marker is absent.

host=/mnt/kestrel-host-logs

sudo -n mkdir -p "$host" 2>/dev/null || true
if ! mountpoint -q "$host" 2>/dev/null; then
  sudo -n modprobe 9p 9pnet 9pnet_virtio 2>/dev/null || true
  sudo -n mount -t 9p -o trans=virtio,version=9p2000.L kestrel_host_logs "$host" 2>/dev/null || true
fi

[[ -f $host/run-bench ]] || exit 0
marker="$(cat "$host/run-bench" 2>/dev/null || true)"
rm -f "$host/run-bench"

mode=all
reps="${KESTREL_BENCH_REPS:-5}"
bg=0
variants=""
layers=""
pmode="all"
while IFS='=' read -r k v; do
  case "$k" in
    mode) mode="$v" ;;
    reps) reps="$v" ;;
    bg) bg="$v" ;;
    variants) variants="$v" ;;
    layers) layers="$v" ;;
    pmode) pmode="$v" ;;
  esac
done <<<"$marker"

# The live image does not run the installed system's first-run unit enablement,
# so the class slices and the broker may be absent. Start them for the session
# that owns the compositor before any resource measurement.
session_user=kestrel
session_uid=$(id -u "$session_user" 2>/dev/null || echo 1000)
runuser -u "$session_user" -- env \
  XDG_RUNTIME_DIR="/run/user/$session_uid" \
  DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$session_uid/bus" \
  /usr/bin/systemctl --user start kestrel-slices.service kestrel-broker.service >/dev/null 2>&1 || true
sleep 1

if [[ $marker == quick* ]]; then
  mode=all
  reps=1
  variants="bridge:scx_kestrel::on:on"
fi

if [[ -n $layers && -f $layers ]]; then
  sudo -n install -m644 "$layers" /usr/share/scx_kestrel/kestrel-layers.json || true
fi

if [[ $mode == packages ]]; then
  # The live image does not enable system services either; start the default
  # sched_ext scheduler so package numbers are measured under scx_kestrel.
  sudo -n systemctl start scx_loader.service >/dev/null 2>&1 || true
  sleep 1
  export KESTREL_PACKAGES_MODE="$pmode"
  export KESTREL_PACKAGES_CLEAN=1
  timeout 1800 /usr/share/kestrel-bench/bench/packages packages || true
  sudo -n systemctl poweroff 2>/dev/null || true
  exit 0
fi

export KESTREL_BENCH_MODE="$mode"
export KESTREL_BENCH_REPS="$reps"
export KESTREL_BENCH_BG_CPUS="$bg"
[[ -n $variants ]] && export KESTREL_MATRIX_VARIANTS="$variants"

timeout 7200 /usr/bin/kestrel-bench || true
sudo -n systemctl poweroff 2>/dev/null || true
